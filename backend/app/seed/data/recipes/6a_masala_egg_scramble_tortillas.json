 "steps": [
  {
   "section": "prep",
   "text": "Chop the onion and tomatoes, mince the jalapeño and beat the eggs with the salt."
  },
  {
   "section": "stovetop",
   "text": "Heat the oil in a skillet over medium heat. Cook the onion and jalapeño until soft, about 4 minutes, then add the tomatoes, turmeric and chili powder and cook 3 minutes more.",
   "duration_minutes": 7
  },
  {
   "section": "stovetop",
   "text": "Pour in the eggs and stir gently until softly set and no liquid egg remains, 3 to 4 minutes.",
   "duration_minutes": 4,
   "doneness_check_for": "egg-large"
  },
  {
   "section": "assembly",
   "text": "Warm each tortilla on a dry pan about 30 seconds per side, like chapati."
  },
  {
   "section": "portioning",
   "text": "Divide the scramble among 4 plates with 2 tortillas each, topped with cilantro."
  },
  {
   "section": "storage",
   "text": "Cool, then refrigerate in the containers."
  },
  {
   "section": "reheating",
