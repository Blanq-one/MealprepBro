 "steps": [
  {
   "section": "prep",
   "text": "Peel and devein the shrimp if needed. Chop the onion and tomatoes; grate the ginger and garlic."
  },
  {
   "section": "rice",
   "text": "Bring 540 ml of water to a boil, add the rinsed rice, cover and simmer on low 15 minutes. Rest off the heat 10 minutes, then fluff.",
   "duration_minutes": 25
  },
  {
   "section": "stovetop",
   "text": "Heat the oil in a pan over medium heat. Cook the onion until soft, 6 minutes, then the ginger, garlic and spices for 1 minute. Add the tomatoes and cook until they break down, 5 minutes.",
   "duration_minutes": 12
  },
  {
   "section": "stovetop",
   "text": "Stir in the coconut milk and salt and simmer 5 minutes. Add the shrimp and cook until pink and opaque, 3 to 4 minutes. Squeeze in the lime.",
   "duration_minutes": 9,
   "doneness_check_for": "shrimp"
  },
  {
   "section": "portioning",
   "text": "Divide the rice and curry among 4 containers; top with cilantro."
  },
  {
   "section": "storage",
   "text": "Cool, then refrigerate in the containers."
  },
  {
   "section": "reheating",
   "text": "Reheat covered, stirring halfway, until hot all the way through."
  }
 ]
