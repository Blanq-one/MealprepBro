   "hands_off_minutes": 0
  },
  {
   "section": "assembly",
   "text": "Rub the butter under and over the skin. Put the lemon halves and whole garlic inside the bird and tie the legs. Toss the vegetables with the oil and the rest of the salt and pepper in a roasting pan and set the chicken on top.",
   "hands_on_minutes": 10,
   "hands_off_minutes": 0
  },
  {
