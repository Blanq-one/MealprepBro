 "steps": [
  {
   "section": "prep",
   "text": "Cut the chicken. Chop the onion, grate the ginger and garlic, drain the chickpeas."
  },
  {
   "section": "rice",
   "text": "Bring 540 ml of water to a boil, add the rinsed rice, cover and simmer on low 15 minutes. Rest off the heat 10 minutes, then fluff.",
   "duration_minutes": 25
  },
  {
   "section": "stovetop",
   "text": "Heat the oil in a heavy pot over medium heat. Cook the onion until deep golden, 10 minutes. Add the ginger, garlic, cumin, coriander, turmeric and chili powder for 1 minute.",
   "duration_minutes": 11
  },
  {
   "section": "stovetop",
   "text": "Add the tomatoes and salt and cook until thick, 8 minutes. Add the chicken and chickpeas, cover and simmer until the chicken is cooked through, about 15 minutes. Stir in the garam masala and lemon juice.",
   "duration_minutes": 23,
   "doneness_check_for": "chicken-thigh-boneless-skinless"
  },
  {
   "section": "portioning",
   "text": "Divide the rice and curry among 4 containers; top with cilantro."
  },
  {
   "section": "storage",
   "text": "Cool, then refrigerate in the containers."
  },
  {
   "section": "reheating",
   "text": "Reheat covered, stirring halfway, until hot all the way through."
  }
