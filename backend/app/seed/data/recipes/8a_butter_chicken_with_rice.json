  },
  {
   "section": "rice",
   "text": "Bring 540 ml of water to a boil, add the rinsed rice, cover and simmer on low 15 minutes. Rest off the heat 10 minutes, then fluff.",
   "duration_minutes": 25,
   "component": "rice",
   "equipment": "stovetop",
   "hands_on_minutes": 2,
   "hands_off_minutes": 23
  },
  {
   "section": "stovetop",
   "text": "Melt half the butter in a heavy pot over medium heat. Cook the onion until soft and golden, 8 minutes, then the ginger and garlic for 1 minute.",
   "duration_minutes": 9,
   "component": "sauce",
   "equipment": "stovetop",
   "hands_on_minutes": 9,
   "hands_off_minutes": 0
  },
  {
   "section": "stovetop",
   "text": "Add the tomato sauce, fenugreek, sugar and remaining salt and simmer 10 minutes.",
