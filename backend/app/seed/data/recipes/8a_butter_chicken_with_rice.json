  {
   "section": "marinate",
   "text": "Toss the chicken with the yogurt, half the garam masala, the chili powder, cumin and 1/2 tsp of the salt. Marinate at least 20 minutes.",
   "duration_minutes": 20,
   "component": "chicken",
   "hands_on_minutes": 4,
