   "hands_off_minutes": 2,
   "stage": 1
  },
  {
   "section": "stovetop",
   "text": "Add the ginger-garlic paste and cook 1 minute. Add the tomatoes, turmeric, chili powder, coriander, cumin and salt; cook until the tomatoes break down and the oil separates, about 8 minutes.",
   "duration_minutes": 9,
   "component": "gravy",
