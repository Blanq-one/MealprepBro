# Copy to .env and adjust. Never commit .env. Placeholders only: no real key, hash, secret or password here.
# Production (Vercel) needs: DATABASE_URL, DATABASE_URL_UNPOOLED, AUTH_PASSWORD_HASH, SESSION_SECRET, GROQ_API_KEY,
# LLM_MODEL, LLM_IDEAS_MODEL, LLM_STRUCTURED_MODE and RUN_MIGRATIONS_ON_DEPLOY (docs/deploy.md, step 6). Vercel
# sets VERCEL and VERCEL_ENV itself; don't add them.

# Postgres used by `docker compose` (service: db) and by the backend.
POSTGRES_USER=mealbro
POSTGRES_PASSWORD=mealbro
POSTGRES_DB=mealbro

# Backend connection strings (SQLAlchemy + psycopg 3; plain postgres:// URLs from Neon work too).
# Inside docker compose the hosts are `db` and `db-test`; from your machine use localhost.
DATABASE_URL=postgresql+psycopg://mealbro:mealbro@localhost:5432/mealbro
TEST_DATABASE_URL=postgresql+psycopg://mealbro:mealbro@localhost:5433/mealbro_test
# Cloud (Neon): DATABASE_URL is the pooled (-pooler) string; migrations use the direct one below
# (postgresql://<user>:<password>@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require). Empty = DATABASE_URL.
DATABASE_URL_UNPOOLED=
# Connection pool: unset = "null" on Vercel (one connection per request), "queue" elsewhere.
# DB_POOL=queue
DB_CONNECT_TIMEOUT_SECONDS=15
DB_CONNECT_RETRIES=3

# Where `cli usda-import` looks for the USDA FoodData Central CSV zips (see docs/data-sources.md).
USDA_RAW_DIR=../data/raw/usda

LOG_LEVEL=INFO

# ---------------- LLM (Phase 1) ----------------
# Groq API key (https://console.groq.com/keys). Placeholder only: put the real key in .env, never here.
GROQ_API_KEY=your-groq-api-key
LLM_PROVIDER=groq
# A Groq model that supports strict structured outputs (checked 2026-10-08: openai/gpt-oss-20b,
# openai/gpt-oss-120b, qwen/qwen3.8-27b). The app never hardcodes a model name.
LLM_MODEL=your-groq-model-id
# The ideas pass (meal-now ideas and their revision) on a separate model; steps and planning stay on LLM_MODEL.
# Empty = LLM_MODEL. docker compose defaults it to openai/gpt-oss-20b when this line is absent from .env (measured
# 2026-10-11: ~3 s a call vs ~7 s on 120b, the same share of ideas passing); set it on Vercel too. Each model has
# its own per-minute allowance on Groq.
LLM_IDEAS_MODEL=your-groq-ideas-model-id
# strict = constrained decoding; best_effort = schema in the prompt + validation and retry.
# If the model rejects strict mode, the run fails with a message telling you to switch.
LLM_STRUCTURED_MODE=strict
LLM_MAX_ATTEMPTS=3
LLM_MAX_TRANSPORT_RETRIES=3
LLM_TIMEOUT_SECONDS=60
# Reasoning effort for every call: set the LOWEST value the model's Groq docs list (low for the openai/gpt-oss
# models), or leave it empty for a model that has no such setting. Reasoning counts as completion tokens, so a
# lower effort makes every call smaller. A value the model rejects stops the call with a message naming this
# variable.
LLM_REASONING_EFFORT=low
# The maximum completion for Phase 1's full-recipe calls (POST /plans). Ideas and steps calls (Phase 2b) size
# their own maximum to fit the minute's allowance.
LLM_MAX_COMPLETION_TOKENS=3000
# Rolling 24-hour token budget across all runs (Groq's free tier allows 200K/day).
LLM_DAILY_TOKEN_BUDGET=150000
LLM_MAX_CALLS_PER_RUN=12
# The longest rate-limit pause a request waits (with a countdown on screen); a longer one ends the request
# gracefully and says when to try again.
LLM_MAX_RATE_WAIT_SECONDS=60
# The per-minute token allowance assumed until Groq's x-ratelimit-limit-tokens header arrives (free tier: 8000).
LLM_TOKENS_PER_MINUTE=8000
# More ideas writes the next batch in the background only while it leaves at least this much of the daily
# budget for calls you ask for (step 2b.3b).
LLM_PREFETCH_DAILY_RESERVE=30000
# Set to 1 only when you want `pytest -m live_llm` to make real Groq calls (about 4 calls, ~25K tokens).
RUN_LIVE_LLM_TESTS=0

# ---------------- Solver (Phase 1) ----------------
# The gaps normally stop the solver first; the time limit is a safety net (a week that hits it is "feasible").
# 30 since Phase 2b (E7): the seed week needs about 20-28 s to reach its gap on this PC (D43).
SOLVER_TIME_LIMIT_SECONDS=30
SOLVER_GAP_REL=0.005
SOLVER_GAP_ABS=1.0

# ---------------- Sign-in (Phase 2) ----------------
# One app password. Make both lines with: cd backend && uv run python -m app.cli hash-password
# (the hash has no `$`, so docker compose reads it as is). Changing SESSION_SECRET signs every device out.
AUTH_PASSWORD_HASH=
SESSION_SECRET=
# false for this local .env (plain http on your home Wi-Fi: a Secure cookie would never come back).
# Leave it unset on Vercel, where it defaults to true (https only).
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_DAYS=180
# Extra origins allowed to send changes, comma-separated (same-origin requests are always allowed).
ALLOWED_ORIGINS=
# Proxies whose X-Forwarded-For is believed (addresses, networks or host names, comma-separated), off Vercel only:
# the login rate limit is keyed on the real client address (PD1). Only a proxy that appends the address it saw
# (nginx's $proxy_add_x_forwarded_for), never the Next dev server, which passes a client's own header along.
# Empty = none: the socket's peer is the client (on your Wi-Fi, every device shares the dev server's counter).
# Not needed on Vercel, whose own header is used.
TRUSTED_PROXIES=
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_GLOBAL=20
LOGIN_WINDOW_MINUTES=15

# ---------------- Deploying (step 2b.13) ----------------
# Vercel's build step (python -m app.deploy) runs the migrations on production deployments when this is 1.
RUN_MIGRATIONS_ON_DEPLOY=0
# Production on a host other than Vercel: APP_ENV=production turns on the startup safety checks (app/production.py:
# a Secure cookie, a real SESSION_SECRET and AUTH_PASSWORD_HASH, a database that isn't localhost). On Vercel they
# run on production deployments by themselves (VERCEL_ENV).
APP_ENV=

# ---------------- Planning inside one request (Phase 2) ----------------
# Every LLM call, rate-limit wait and solve of one plan request fits in this budget (Vercel Hobby stops a
# function at 300 s); unfinished runs older than PLAN_STALE_AFTER_SECONDS are marked interrupted.
PLAN_TIME_BUDGET_SECONDS=180
PLAN_STALE_AFTER_SECONDS=330

# ---------------- Frontend dev server (Phase 2) ----------------
# Where `npm run dev` proxies /api (docker compose sets http://backend:8000).
BACKEND_ORIGIN=http://localhost:8000
# Extra origins the Next dev server accepts (your LAN address is covered by default), comma-separated.
DEV_ALLOWED_ORIGINS=
