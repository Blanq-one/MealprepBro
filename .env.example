# Copy to .env and adjust. Never commit .env.

# Postgres used by `docker compose` (service: db) and by the backend.
POSTGRES_USER=mealbro
POSTGRES_PASSWORD=mealbro
POSTGRES_DB=mealbro

# Backend connection strings (SQLAlchemy + psycopg 3).
# Inside docker compose the hosts are `db` and `db-test`; from your machine use localhost.
DATABASE_URL=postgresql+psycopg://mealbro:mealbro@localhost:5432/mealbro
TEST_DATABASE_URL=postgresql+psycopg://mealbro:mealbro@localhost:5433/mealbro_test

# Where `cli usda-import` looks for the USDA FoodData Central CSV zips (see docs/data-sources.md).
USDA_RAW_DIR=../data/raw/usda

LOG_LEVEL=INFO
