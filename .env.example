# Copy to .env and adjust. Never commit .env.

# Postgres used by `docker compose` (service: db) and by the backend.
POSTGRES_USER=mealbro
POSTGRES_PASSWORD=mealbro
POSTGRES_DB=mealbro

# Backend connection strings (SQLAlchemy + psycopg 3; plain postgres:// URLs from Neon work too).
# Inside docker compose the hosts are `db` and `db-test`; from your machine use localhost.
DATABASE_URL=postgresql+psycopg://mealbro:mealbro@localhost:5432/mealbro
TEST_DATABASE_URL=postgresql+psycopg://mealbro:mealbro@localhost:5433/mealbro_test
# Cloud (Neon): DATABASE_URL is the pooled (-pooler) string; migrations use the direct one below.
# DATABASE_URL_UNPOOLED=postgresql://...@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Connection pool: unset = "null" on Vercel (one connection per request), "queue" elsewhere.
# DB_POOL=queue
DB_CONNECT_TIMEOUT_SECONDS=15
DB_CONNECT_RETRIES=3

# Where `cli usda-import` looks for the USDA FoodData Central CSV zips (see docs/data-sources.md).
USDA_RAW_DIR=../data/raw/usda

LOG_LEVEL=INFO

# ---------------- LLM (Phase 1) ----------------
# Groq API key (https://console.groq.com/keys). Placeholder only: put the real key in .env, never here.
GROQ_API_KEY=your-groq-api-key
LLM_PROVIDER=groq
# A Groq model that supports strict structured outputs (checked 2026-10-08: openai/gpt-oss-20b,
# openai/gpt-oss-120b, qwen/qwen3.8-27b). The app never hardcodes a model name.
LLM_MODEL=your-groq-model-id
# strict = constrained decoding; best_effort = schema in the prompt + validation and retry.
# If the model rejects strict mode, the run fails with a message telling you to switch.
LLM_STRUCTURED_MODE=strict
LLM_MAX_ATTEMPTS=3
LLM_MAX_TRANSPORT_RETRIES=3
LLM_TIMEOUT_SECONDS=60
LLM_REASONING_EFFORT=low
LLM_MAX_COMPLETION_TOKENS=3000
# Rolling 24-hour token budget across all runs (Groq's free tier allows 200K/day).
LLM_DAILY_TOKEN_BUDGET=150000
LLM_MAX_CALLS_PER_RUN=12
LLM_MAX_RATE_WAIT_SECONDS=60
# Set to 1 only when you want `pytest -m live_llm` to make one real Groq call.
RUN_LIVE_LLM_TESTS=0

# ---------------- Solver (Phase 1) ----------------
# The gaps normally stop the solver first; the time limit is a safety net (a week that hits it is "feasible").
SOLVER_TIME_LIMIT_SECONDS=12
SOLVER_GAP_REL=0.005
SOLVER_GAP_ABS=1.0

# ---------------- Sign-in (Phase 2) ----------------
# One app password. Make both lines with: cd backend && uv run python -m app.cli hash-password
# (the hash has no `$`, so docker compose reads it as is). Changing SESSION_SECRET signs every device out.
AUTH_PASSWORD_HASH=
SESSION_SECRET=
# false for this local .env (plain http on your home Wi-Fi: a Secure cookie would never come back).
# Leave it unset on Vercel, where it defaults to true (https only).
SESSION_COOKIE_SECURE=false
SESSION_MAX_AGE_DAYS=180
# Extra origins allowed to send changes, comma-separated (same-origin requests are always allowed).
ALLOWED_ORIGINS=
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_GLOBAL=20
LOGIN_WINDOW_MINUTES=15

# ---------------- Planning inside one request (Phase 2) ----------------
# Every LLM call, rate-limit wait and solve of one plan request fits in this budget (Vercel Hobby stops a
# function at 300 s); unfinished runs older than PLAN_STALE_AFTER_SECONDS are marked interrupted.
PLAN_TIME_BUDGET_SECONDS=180
PLAN_STALE_AFTER_SECONDS=330

# ---------------- Frontend dev server (Phase 2) ----------------
# Where `npm run dev` proxies /api (docker compose sets http://backend:8000).
BACKEND_ORIGIN=http://localhost:8000
# Extra origins the Next dev server accepts (your LAN address is covered by default), comma-separated.
DEV_ALLOWED_ORIGINS=
