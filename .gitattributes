# Normalize line endings: LF in the repo and in the working tree for files that run in Linux containers.
* text=auto
*.py text eol=lf
*.sh text eol=lf
*.toml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mako text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
Dockerfile text eol=lf
uv.lock text eol=lf
*.zip binary
*.pdf binary
*.png binary
